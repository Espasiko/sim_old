# Database (Required)
DATABASE_URL="postgresql://postgres:password@localhost:5432/postgres"

# PostgreSQL Port (Optional) - defaults to 5432 if not specified
# POSTGRES_PORT=5432

# Authentication (Required)
BETTER_AUTH_SECRET=your_secret_key  # Use `openssl rand -hex 32` to generate, or visit https://www.better-auth.com/docs/installation
BETTER_AUTH_URL=http://localhost:3000

# NextJS (Required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security (Required)
ENCRYPTION_KEY=your_encryption_key  # Use `openssl rand -hex 32` to generate, used to encrypt environment variables
INTERNAL_API_SECRET=your_internal_api_secret # Use `openssl rand -hex 32` to generate, used to encrypt internal api routes

# Email Provider (Optional)
# RESEND_API_KEY=  # Uncomment and add your key from https://resend.com to send actual emails
                   # If left commented out, emails will be logged to console instead

# Local AI Models (Optional)
# OLLAMA_URL=http://localhost:11434  # URL for local Ollama server - uncomment if using local models

# ==========================================================
# COPILOT LOCAL CONFIGURATION (Optional - for local providers)
# ==========================================================
# By default, Copilot uses the official Sim AI service (copilot.sim.ai)
# Configure these to use your own API keys and local providers instead

# Option 1: Use Groq (Fast & Free)
# COPILOT_PROVIDER=groq
# COPILOT_MODEL=llama-3.1-8b-instant
# COPILOT_CHAT_PROVIDER=groq
# COPILOT_CHAT_MODEL=llama-3.1-8b-instant
# COPILOT_RAG_PROVIDER=groq
# COPILOT_RAG_MODEL=llama-3.1-8b-instant
# GROQ_API_KEY=your_groq_api_key_here

# Option 2: Use Cerebras (Free)
# COPILOT_PROVIDER=cerebras
# COPILOT_MODEL=llama3.1-8b
# COPILOT_CHAT_PROVIDER=cerebras
# COPILOT_CHAT_MODEL=llama3.1-8b
# COPILOT_RAG_PROVIDER=cerebras
# COPILOT_RAG_MODEL=llama3.1-8b
# CEREBRAS_API_KEY=your_cerebras_api_key_here

# Option 3: Use Ollama (Local - No API Key Required)
# COPILOT_PROVIDER=ollama
# COPILOT_MODEL=mistral
# COPILOT_CHAT_PROVIDER=ollama
# COPILOT_CHAT_MODEL=mistral
# COPILOT_RAG_PROVIDER=ollama
# COPILOT_RAG_MODEL=mistral
# OLLAMA_URL=http://localhost:11434

# Other Provider API Keys (Optional)
# OPENAI_API_KEY=your_openai_key_here
# GOOGLE_API_KEY=your_google_key_here
# ANTHROPIC_API_KEY_1=your_anthropic_key_here
# MISTRAL_API_KEY=your_mistral_key_here
# COHERE_API_KEY=your_cohere_key_here

# Fallback to Official Sim AI Service (Optional)
# SIM_AGENT_API_URL=https://copilot.sim.ai
# COPILOT_API_KEY=your_sim_copilot_api_key_here

