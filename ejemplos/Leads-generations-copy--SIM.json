      "b0eb30e3-c46e-4bad-b5f1-a08baf59de55": {
        "id": "b0eb30e3-c46e-4bad-b5f1-a08baf59de55",
        "type": "function",
        "name": "Duplicates",
        "position": {
          "x": 809.3826190201961,
          "y": 1176.7687039635503
        },
        "enabled": true,
        "horizontalHandles": true,
        "isWide": false,
        "advancedMode": false,
        "triggerMode": false,
        "height": 394.65625,
        "subBlocks": {
          "code": {
            "id": "code",
            "type": "code",
            "value": "const contacts = <searcher.contacts>;\nconst leads = <leads.data.values>;\n\nconst leadsSet = new Set(leads.map(lead => lead[0]));\n\nconst filteredContacts = contacts.filter(contact => !leadsSet.has(contact[0]));\n\nreturn filteredContacts;"
          }
        },
        "outputs": {
          "result": "any",
          "stdout": "string"
        },
        "data": {},
        "layout": {
          "measuredWidth": 317.328125,
          "measuredHeight": 394.65625
        }
      },
